<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's own atom: a display case slot with a caught-shiny rim and pip.

  Deliberately not a Poke Ball. That is Nintendo's mark, and docs/design-decisions.md rules
  out official branding entirely; the slot is also the more distinctive choice, because it
  is the thing the whole app is built out of.

  Geometry notes, both learned by looking at it on a launcher:

   * Adaptive icons have a 108x108 viewport but only the centre 66x66 survives every mask,
     so the artwork sits inside 21..87.
   * The pip must clear the rim by a visible margin. A first version placed it at the same
     radius the grid uses and it merged into the stroke at launcher size, reading as a bite
     out of the corner rather than as a mark.

  Gold appears here exactly as the design system allows: a caught slot rim and its pip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The recess, darker than the case behind it so the slot reads as a well. -->
    <path android:fillColor="#0E0C0D" android:pathData="M37,28h34a9,9 0 0 1 9,9v34a9,9 0 0 1 -9,9h-34a9,9 0 0 1 -9,-9v-34a9,9 0 0 1 9,-9z" />

    <!-- The caught rim. Heavier than the grid's 2dp, because 2dp vanishes at 48px. -->
    <path
        android:strokeColor="#D8B26A"
        android:strokeWidth="4.5"
        android:fillColor="#00000000"
        android:pathData="M37,28h34a9,9 0 0 1 9,9v34a9,9 0 0 1 -9,9h-34a9,9 0 0 1 -9,-9v-34a9,9 0 0 1 9,-9z" />

    <!-- The pip: the second, non-colour signal that a slot is filled. -->
    <path android:fillColor="#D8B26A" android:pathData="M66,42m-7,0a7,7 0 1,0 14,0a7,7 0 1,0 -14,0z" />
</vector>
