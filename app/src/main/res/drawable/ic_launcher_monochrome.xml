        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:fillColor="#00000000"
        android:pathData="M37,28h34a9,9 0 0 1 9,9v34a9,9 0 0 1 -9,9h-34a9,9 0 0 1 -9,-9v-34a9,9 0 0 1 9,-9z" />
    <path android:fillColor="#FFFFFF" android:pathData="M66,42m-7,0a7,7 0 1,0 14,0a7,7 0 1,0 -14,0z" />
</vector>
