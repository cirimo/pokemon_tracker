<resources>
    <!--
      A launch theme only. The real theming is PokedexTheme in :design-system.
      The background matches CaseColors.CaseBlack so the cold-start frame does not
      flash white before Compose draws.
    -->
    <style name="Theme.Pokedex" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/case_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
