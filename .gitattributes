* text=auto eol=lf

*.bat text eol=crlf
gradlew text eol=lf
*.jar binary
*.webp binary
*.db binary
*.png binary
*.ttf binary

# The shiny sprite set is ~1400 files and about 17 MB, regenerated as a unit by
# tools/dataset-pipeline. LFS keeps that out of the git object history; reference.db is
# under 1 MB and diffs are meaningless either way, so it stays a plain binary blob.
core/data/src/main/assets/sprites/*.webp filter=lfs diff=lfs merge=lfs -text
